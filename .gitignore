# 1. Generated by Python: rebuilt on every run, pure noise in diffs
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# 2. Local environment: differs per machine, large, reproducible from pyproject.toml
.venv/
venv/

# 3. Tool caches: speed-ups for your machine only
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 4. Secrets and machine-specific files: must never be public
.env
.env.*
*.pem
.DS_Store
.vscode/
.idea/
